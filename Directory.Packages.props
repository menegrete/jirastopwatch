<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- NU1507 fires whenever the machine's NuGet.config has more than one
         package source and CPM is enabled; it's about local feed
         configuration, not this repo's code, and varies per developer/CI
         machine, so it's not something a project setting can fix. -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared -->
    <PackageVersion Include="RestSharp" Version="112.0.0" />
    <PackageVersion Include="MaterialDesignThemes" Version="5.3.2" />

    <!-- Samples/HelloSqlite only: the native-dependency plugin sample -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Pinned above the version Microsoft.Data.Sqlite pulls in transitively
         (2.1.11, GHSA-2m69-gcr7-jv3q), which would fail the build via NU1903. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />

    <!-- StopWatchTest -->
    <PackageVersion Include="Castle.Core" Version="5.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
