<Project Sdk="Microsoft.NET.Sdk">

  <!-- The spike/gate for the plugin mechanism: a plugin with a managed
       dependency (Microsoft.Data.Sqlite) that in turn loads a native DLL
       (e_sqlite3.dll). If this loads and runs on a machine, plugins with
       private dependencies work there. Not shipped with the application. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HelloSqlite</RootNamespace>
    <AssemblyName>HelloSqlite</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- A plugin is a folder of loose files: its package dependencies must
         land next to it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StopWatch.Plugin.Abstractions\StopWatch.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The host's Avalonia is the one used at runtime: ExcludeAssets="runtime"
         keeps the plugin folder free of a second copy (a second copy would
         make Window a different type from the host's). In a plugin repository
         this is the same reference, with the host's Avalonia version. -->
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- CopyLocalLockFileAssemblies also copies the packages Avalonia depends on
       (ExcludeAssets above only covers Avalonia itself). The host has them all.
       Matched by package id, so check this list when Avalonia's dependencies change. -->
  <Target Name="LeaveAvaloniaToTheHost" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.NuGetPackageId)').StartsWith('Avalonia')) Or $([System.String]::Copy('%(ReferenceCopyLocalPaths.NuGetPackageId)').StartsWith('MicroCom'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
