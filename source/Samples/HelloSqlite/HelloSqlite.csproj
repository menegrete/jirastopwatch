<Project Sdk="Microsoft.NET.Sdk">

  <!-- The spike/gate for the plugin mechanism: a plugin with a managed
       dependency (Microsoft.Data.Sqlite) that in turn loads a native DLL
       (e_sqlite3.dll). If this loads and runs on a machine, plugins with
       private dependencies work there. Not shipped with the application. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HelloSqlite</RootNamespace>
    <AssemblyName>HelloSqlite</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- A plugin is a folder of loose files: its package dependencies must
         land next to it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StopWatch.Plugin.Abstractions\StopWatch.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
