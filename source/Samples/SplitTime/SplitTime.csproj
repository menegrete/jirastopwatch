<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample plugin for the time-load pipeline: splits the time of an issue
       among its subtasks. Build it, then copy the output folder to
       %LocalAppData%\StopWatch\plugins\SplitTime\ (see docs/plugins.md).
       Not shipped with the application. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SplitTime</RootNamespace>
    <AssemblyName>SplitTime</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: the host already has the contract assembly loaded,
         and a plugin must never ship its own copy. In a plugin repository
         this is a PackageReference to StopWatch.Plugin.Abstractions with
         ExcludeAssets="runtime". -->
    <ProjectReference Include="..\..\StopWatch.Plugin.Abstractions\StopWatch.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
