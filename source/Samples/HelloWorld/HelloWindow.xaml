<Window x:Class="HelloWorld.HelloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hello from a plugin"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Background}">
    <!-- Background and Text are the host's theme brushes: referenced
         dynamically, the window follows the application's theme. -->
    <StackPanel Margin="16">
        <TextBlock Text="Hello, World!"
                   FontSize="18"
                   Foreground="{DynamicResource Text}" />
        <TextBlock x:Name="lblInfo"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Text}" />
        <Button Content="Close"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Padding="16,4" />
    </StackPanel>
</Window>
