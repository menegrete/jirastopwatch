<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StopWatchTest</RootNamespace>
    <AssemblyName>StopWatchTest</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Castle.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="RestSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StopWatch\StopWatch.csproj" />
    <ProjectReference Include="..\StopWatch.Plugin.Abstractions\StopWatch.Plugin.Abstractions.csproj" />

    <!-- Built first so the plugin integration test can load their output;
         ReferenceOutputAssembly=false keeps them out of this assembly. -->
    <ProjectReference Include="..\Samples\HelloWorld\HelloWorld.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Samples\HelloSqlite\HelloSqlite.csproj" ReferenceOutputAssembly="false" />

    <!-- Referenced for real: its handler is exercised directly through the host's pipeline. -->
    <ProjectReference Include="..\Samples\SplitTime\SplitTime.csproj" />
  </ItemGroup>

</Project>
