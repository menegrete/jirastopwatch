<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Still -windows: the Win32 interop (Taskbar*, NativeMethods, DPApi) and
         Microsoft.Win32 use remain until the platform services are split out.
         See openspec change "migrate-ui-to-avalonia", tasks 6 and 7. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StopWatch</RootNamespace>
    <AssemblyName>StopWatch</AssemblyName>
    <ApplicationIcon>stopwatchicon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Bindings in the ported XAML are still reflection-based; compiled
         bindings need x:DataType everywhere. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="RestSharp" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.Formats.Nrbf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StopWatch.Plugin.Abstractions\StopWatch.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also the ApplicationIcon above; Avalonia reads it as an avares:// asset
         for the window and tray icons. -->
    <AvaloniaResource Include="stopwatchicon.ico" />
  </ItemGroup>

</Project>
