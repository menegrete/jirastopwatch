<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Deliberately and permanently on, even though the UI is WPF: the tray
         icon (System.Windows.Forms.NotifyIcon) and screen enumeration
         (System.Windows.Forms.Screen, used by ScreenPlacement) have no WPF
         equivalent. See openspec design "migrate-ui-to-wpf", Non-Goals. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>StopWatch</RootNamespace>
    <AssemblyName>StopWatch</AssemblyName>
    <ApplicationIcon>stopwatchicon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF's ThemeMode API is still experimental and emits WPF0001, which
         TreatWarningsAsErrors would turn into a build failure. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RestSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also the ApplicationIcon above, but the windows need it as a resource
         so that XAML can reference it by pack URI. -->
    <Resource Include="stopwatchicon.ico" />
  </ItemGroup>

</Project>
