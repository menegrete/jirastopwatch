<Window x:Class="StopWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StopWatch"
        x:ClassModifier="internal"
        Title="Jira StopWatch"
        Icon="/stopwatchicon.ico"
        Background="{DynamicResource Background}"
        MinWidth="620"
        SizeToContent="Height"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="12"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <!--
        The height is derived, not chosen: SizeToContent="Height" makes the
        window as tall as the rows need, which is why a row is free to be one or
        two lines tall. ResizeMode stays CanResize so the user can drag the
        width; a drag on the bottom edge is undone by the next layout pass,
        which is the issue-list spec's "el alto no cambia".

        MaxHeight is set from the working area in code, and the list sits in a
        ScrollViewer so that a list taller than the screen can still be reached.
    -->

    <Window.Resources>

        <!-- ==================== the row, twice ==================== -->

        <!--
            Compact and spacious are two templates rather than one template
            scaled by a factor. They differ in padding and type size today, and
            the split leaves room for them to differ in more than that. See the
            openspec design, D6.

            Everything below binds to IssueViewModel. The height of each row is
            whatever its own content needs: the summary wraps to a second line
            when the width no longer fits it, and the row grows with it.
        -->

        <!-- Compact: what the WinForms window looked like. -->
        <DataTemplate x:Key="IssueRowCompact">
            <local:ThemeAnimatedBorder IsActive="{Binding IsCurrent}"
                                       ActiveColor="SurfaceActive"
                                       InactiveColor="Surface"
                                       Padding="8,2"
                                       MouseLeftButtonUp="Row_MouseSelected">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="109" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Selection, said again without colour: the transition is
                         never the only carrier of the state. -->
                    <Border Grid.Column="0"
                            Width="3"
                            Margin="0,1,5,1"
                            CornerRadius="2"
                            Background="{DynamicResource Accent}"
                            Visibility="{Binding IsCurrent, Converter={StaticResource WhenTrue}}" />

                    <TextBox Grid.Column="1"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="{Binding IssueKey, UpdateSourceTrigger=LostFocus}"
                             LostFocus="tbIssueKey_LostFocus"
                             KeyDown="tbIssueKey_KeyDown"
                             GotFocus="Row_Selected" />

                    <Button Grid.Column="2"
                            Style="{StaticResource GlyphButton}"
                            Width="24" Height="24"
                            IsEnabled="{Binding CanOpen}"
                            ToolTip="Open issue in browser (CTRL-O)"
                            Click="btnOpen_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphOpenBrowser}" />
                    </Button>

                    <!-- Up to two lines, then trimmed at the end of the second.
                         The row is as tall as this ends up being. -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Summary}"
                               ToolTip="{Binding Summary}"
                               Margin="8,0"
                               FontSize="12"
                               LineHeight="15"
                               LineStackingStrategy="BlockLineHeight"
                               MaxHeight="30"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="4"
                            Style="{StaticResource GlyphButton}"
                            Width="24" Height="24"
                            ToolTip="Start/stop timer (CTRL-P)"
                            Click="btnStartStop_Click">
                        <Grid>
                            <!-- Running or not, said with a shape as well as
                                 with the colour of the field beside it. -->
                            <Path Style="{StaticResource GlyphFill}"
                                  Data="{StaticResource GlyphPause}"
                                  Visibility="{Binding IsRunning, Converter={StaticResource WhenTrue}}" />
                            <Path Style="{StaticResource GlyphFill}"
                                  Data="{StaticResource GlyphPlay}"
                                  Visibility="{Binding IsRunning, Converter={StaticResource WhenFalse}}" />
                        </Grid>
                    </Button>

                    <local:ThemeAnimatedBorder Grid.Column="5"
                                               IsActive="{Binding IsRunning}"
                                               ActiveColor="TimerRunning"
                                               InactiveColor="SurfaceDisabled"
                                               BorderBrush="{DynamicResource Border}"
                                               BorderThickness="1"
                                               CornerRadius="3"
                                               Width="100"
                                               Padding="4,2"
                                               ToolTip="Double-click to edit the time (CTRL-E)"
                                               MouseLeftButtonUp="Row_MouseSelected"
                                               MouseLeftButtonDown="Time_MouseDown">
                        <TextBlock Text="{Binding TimeElapsedText}"
                                   FontSize="12"
                                   FontFamily="Consolas, Courier New, monospace"
                                   TextAlignment="Right" />
                    </local:ThemeAnimatedBorder>

                    <Button Grid.Column="6"
                            Style="{StaticResource GlyphButton}"
                            Width="24" Height="24"
                            IsEnabled="{Binding CanPost}"
                            ToolTip="Submit worklog to Jira and reset timer (CTRL-L)"
                            Click="btnPost_Click">
                        <Grid>
                            <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphPost}" />
                            <!-- A comment is waiting to go with the worklog. -->
                            <Ellipse Width="4" Height="4"
                                     Fill="{DynamicResource Success}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding HasComment, Converter={StaticResource WhenTrue}}" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="7"
                            Style="{StaticResource GlyphButton}"
                            Width="24" Height="24"
                            IsEnabled="{Binding CanReset}"
                            ToolTip="Reset timer (CTRL-R)"
                            Click="btnReset_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphReset}" />
                    </Button>

                    <Button Grid.Column="8"
                            x:Name="btnRemove"
                            Style="{StaticResource GlyphButton}"
                            Width="24" Height="24"
                            ToolTip="Remove issue row (CTRL-DEL)"
                            Click="btnRemove_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphRemove}" />
                    </Button>
                </Grid>
            </local:ThemeAnimatedBorder>
        </DataTemplate>

        <!-- Spacious: the same row, given room to breathe. -->
        <DataTemplate x:Key="IssueRowSpacious">
            <local:ThemeAnimatedBorder IsActive="{Binding IsCurrent}"
                                       ActiveColor="SurfaceActive"
                                       InactiveColor="Surface"
                                       Padding="8,6"
                                       MouseLeftButtonUp="Row_MouseSelected">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="123" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Selection, said again without colour: the transition is
                         never the only carrier of the state. -->
                    <Border Grid.Column="0"
                            Width="3"
                            Margin="0,1,5,1"
                            CornerRadius="2"
                            Background="{DynamicResource Accent}"
                            Visibility="{Binding IsCurrent, Converter={StaticResource WhenTrue}}" />

                    <TextBox Grid.Column="1"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Text="{Binding IssueKey, UpdateSourceTrigger=LostFocus}"
                             LostFocus="tbIssueKey_LostFocus"
                             KeyDown="tbIssueKey_KeyDown"
                             GotFocus="Row_Selected" />

                    <Button Grid.Column="2"
                            Style="{StaticResource GlyphButton}"
                            Width="28" Height="28"
                            IsEnabled="{Binding CanOpen}"
                            ToolTip="Open issue in browser (CTRL-O)"
                            Click="btnOpen_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphOpenBrowser}" />
                    </Button>

                    <!-- Up to two lines, then trimmed at the end of the second.
                         The row is as tall as this ends up being. -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Summary}"
                               ToolTip="{Binding Summary}"
                               Margin="8,0"
                               FontSize="13"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               MaxHeight="36"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="4"
                            Style="{StaticResource GlyphButton}"
                            Width="28" Height="28"
                            ToolTip="Start/stop timer (CTRL-P)"
                            Click="btnStartStop_Click">
                        <Grid>
                            <!-- Running or not, said with a shape as well as
                                 with the colour of the field beside it. -->
                            <Path Style="{StaticResource GlyphFill}"
                                  Data="{StaticResource GlyphPause}"
                                  Visibility="{Binding IsRunning, Converter={StaticResource WhenTrue}}" />
                            <Path Style="{StaticResource GlyphFill}"
                                  Data="{StaticResource GlyphPlay}"
                                  Visibility="{Binding IsRunning, Converter={StaticResource WhenFalse}}" />
                        </Grid>
                    </Button>

                    <local:ThemeAnimatedBorder Grid.Column="5"
                                               IsActive="{Binding IsRunning}"
                                               ActiveColor="TimerRunning"
                                               InactiveColor="SurfaceDisabled"
                                               BorderBrush="{DynamicResource Border}"
                                               BorderThickness="1"
                                               CornerRadius="3"
                                               Width="112"
                                               Padding="4,2"
                                               ToolTip="Double-click to edit the time (CTRL-E)"
                                               MouseLeftButtonUp="Row_MouseSelected"
                                               MouseLeftButtonDown="Time_MouseDown">
                        <TextBlock Text="{Binding TimeElapsedText}"
                                   FontSize="13"
                                   FontFamily="Consolas, Courier New, monospace"
                                   TextAlignment="Right" />
                    </local:ThemeAnimatedBorder>

                    <Button Grid.Column="6"
                            Style="{StaticResource GlyphButton}"
                            Width="28" Height="28"
                            IsEnabled="{Binding CanPost}"
                            ToolTip="Submit worklog to Jira and reset timer (CTRL-L)"
                            Click="btnPost_Click">
                        <Grid>
                            <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphPost}" />
                            <!-- A comment is waiting to go with the worklog. -->
                            <Ellipse Width="4" Height="4"
                                     Fill="{DynamicResource Success}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding HasComment, Converter={StaticResource WhenTrue}}" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="7"
                            Style="{StaticResource GlyphButton}"
                            Width="28" Height="28"
                            IsEnabled="{Binding CanReset}"
                            ToolTip="Reset timer (CTRL-R)"
                            Click="btnReset_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphReset}" />
                    </Button>

                    <Button Grid.Column="8"
                            x:Name="btnRemove"
                            Style="{StaticResource GlyphButton}"
                            Width="28" Height="28"
                            ToolTip="Remove issue row (CTRL-DEL)"
                            Click="btnRemove_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphRemove}" />
                    </Button>
                </Grid>
            </local:ThemeAnimatedBorder>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== the list ==================== -->

        <ScrollViewer Grid.Row="0"
                      x:Name="issueScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="issueList"
                          ItemsSource="{Binding Issues}"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.Style>
                    <!-- This is the mechanism that picks between the two row
                         templates: change the density and every row is
                         re-templated, timers and order untouched. -->
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource IssueRowCompact}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Density}" Value="Spacious">
                                <Setter Property="ItemTemplate" Value="{StaticResource IssueRowSpacious}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== status bar ==================== -->

        <!--
            One line: add / mini view / settings / connection status, then
            whatever room is left, then the total. DockPanel with
            LastChildFill="False" - every child docks to a side and eats its
            own strip, so the gap between the last Left child and the first
            Right child is the free space, with no filler element needed.

            The total's column no longer lines up under the list's time
            column pixel-for-pixel on its left edge: fitting four controls
            before the free space left no room to keep mirroring the row's
            own columns without also widening them (the row's key and
            open-in-browser columns would have had to grow to fit controls
            that have nothing to do with either). The right edge is
            approximated instead, with a trailing spacer the width of the
            row's own trailing buttons - see below.
        -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Divider}" Margin="0" />

            <DockPanel Margin="8,4" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        x:Name="btnAddIssue"
                        Style="{StaticResource GlyphButton}"
                        ToolTip="Add another issue row (CTRL-N)"
                        Click="btnAddIssue_Click">
                    <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphAdd}" />
                </Button>

                <Button DockPanel.Dock="Left"
                        x:Name="btnMiniView"
                        Style="{StaticResource GlyphButton}"
                        ToolTip="Shrink to the floating mini timer"
                        Click="btnMiniView_Click">
                    <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphMiniView}" />
                </Button>

                <Button DockPanel.Dock="Left"
                        x:Name="btnSettings"
                        Style="{StaticResource GlyphButton}"
                        ToolTip="Settings"
                        Click="btnSettings_Click">
                    <Grid Width="11" Height="11">
                        <Path Style="{StaticResource GlyphPath}"
                              Data="{StaticResource GlyphSettingsBars}"
                              HorizontalAlignment="Stretch" />
                        <Ellipse Width="4" Height="4"
                                 Fill="{DynamicResource Text}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="2.5,0.5,0,0" />
                        <Ellipse Width="4" Height="4"
                                 Fill="{DynamicResource Text}"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="5,0,0,0.5" />
                    </Grid>
                </Button>

                <TextBlock DockPanel.Dock="Left"
                           x:Name="lblConnectionStatus"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           MouseLeftButtonUp="lblConnectionStatus_Click" />

                <!--
                    Unlabelled spacer, docked first so it claims the
                    rightmost strip: the width of the row's post/reset/remove
                    buttons (24 each, no margin between them), so the total's
                    right edge lines up with the time column's right edge
                    above it, the same way the row's own trailing buttons
                    push the time column in from the row's right edge.
                -->
                <Border DockPanel.Dock="Right" Width="72" />

                <!-- Right-docked children carve from the right inward, so the
                     value has to be listed before its label to end up to the
                     label's right. -->
                <TextBox DockPanel.Dock="Right"
                         Width="90"
                         IsReadOnly="True"
                         TextAlignment="Right"
                         FontFamily="Consolas, Courier New, monospace"
                         Text="{Binding TotalTimeText, Mode=OneWay}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="Total"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
