<Window x:Class="StopWatch.MiniTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StopWatch"
        x:ClassModifier="internal"
        Width="352" Height="40"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- One row of the list: a single timer's key, summary, time and its
             own pause/resume control. No badge column any more - with several
             timers running, they are all listed instead of just hinted at. -->
        <DataTemplate x:Key="TimerRow">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- stripe -->
                    <ColumnDefinition Width="Auto" />
                    <!-- key -->
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <!-- summary -->
                    <ColumnDefinition Width="Auto" />
                    <!-- time -->
                    <ColumnDefinition Width="Auto" />
                    <!-- pause / resume -->
                </Grid.ColumnDefinitions>

                <!-- Running/paused state, as a coloured stripe down the left edge.
                     Same colour the main window uses on the time field. -->
                <Border Grid.Column="0"
                        Width="4"
                        Margin="4,1,6,1"
                        CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SurfaceDisabled}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TimerRunning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Key plus its two row actions, grouped so hovering the key
                     specifically - not the row, and not the summary/time/pause
                     beside it - is what reveals them. They start collapsed and
                     take no space; the Auto column they live in only grows
                     once they show, which is what shrinks the summary column
                     next to it.

                     Background="Transparent" makes the whole Grid hit-test
                     visible, not just the key text - a Panel with no
                     Background at all only hit-tests its children, so the gap
                     between the key and where a button appears would count as
                     "left the area" and hide them again before the mouse ever
                     reaches one. Visibility is still toggled from code-behind
                     (MouseEnter/MouseLeave below) rather than a Trigger, so
                     leaving briefly through that gap - or a coalesced
                     fast-mouse jump that skips it in one event - has a grace
                     period instead of hiding instantly out from under the
                     cursor. -->
                <Grid x:Name="keyArea"
                      Grid.Column="1"
                      Background="Transparent"
                      MouseEnter="keyArea_MouseEnter"
                      MouseLeave="keyArea_MouseLeave">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding IssueKey}"
                               Foreground="{DynamicResource Text}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <Button x:Name="btnCopyKey"
                            Grid.Column="1"
                            Style="{StaticResource GlyphButton}"
                            Width="18" Height="18"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            ToolTip="Copy issue key"
                            Click="btnCopyKey_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphCopy}" />
                    </Button>

                    <Button x:Name="btnOpen"
                            Grid.Column="2"
                            Style="{StaticResource GlyphButton}"
                            Width="18" Height="18"
                            Margin="2,0,0,0"
                            Visibility="Collapsed"
                            IsEnabled="{Binding Summary, Converter={StaticResource NotEmpty}}"
                            ToolTip="Open issue in browser"
                            Click="btnOpen_Click">
                        <Path Style="{StaticResource GlyphPath}" Data="{StaticResource GlyphOpenBrowser}" />
                    </Button>
                </Grid>

                <!-- The pill is narrow by design, so the full text lives in the
                     tooltip; only the key and the clock are guaranteed room. -->
                <TextBlock Grid.Column="2"
                           Text="{Binding Summary}"
                           ToolTip="{Binding Summary}"
                           Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="3"
                           Text="{Binding ElapsedText}"
                           Foreground="{DynamicResource Text}"
                           FontFamily="Consolas, Courier New, monospace"
                           FontWeight="Bold"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center" />

                <Button Grid.Column="4"
                        Style="{StaticResource GlyphButton}"
                        Click="RowToggle_Click">
                    <Grid>
                        <!-- pause: two bars -->
                        <Path Visibility="{Binding IsRunning, Converter={StaticResource WhenTrue}}"
                              Fill="{DynamicResource Text}"
                              Data="M 0,0 H 3.5 V 11 H 0 Z M 6,0 H 9.5 V 11 H 6 Z" />
                        <!-- play: triangle -->
                        <Path Visibility="{Binding IsRunning, Converter={StaticResource WhenFalse}}"
                              Fill="{DynamicResource Text}"
                              Data="M 0,0 L 10,5.5 L 0,11 Z" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Margin leaves room for the shadow to fall outside the pill. -->
    <Border Margin="6"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <ItemsControl x:Name="rowsList"
                          Margin="0,0,32,0"
                          ItemTemplate="{StaticResource TimerRow}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Independent of the row list on purpose: with several timers
                 shown there is exactly one way back to the full window, not
                 one per row. Floats over the top-right corner instead of
                 taking a column, so it stays put whether there is one row or
                 several. -->
            <Button x:Name="btnRestore"
                    Style="{StaticResource GlyphButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,2,4,0"
                    ToolTip="Back to the full window"
                    Click="btnRestore_Click">
                <!-- arrow out of a box, pointing up-right -->
                <Path Stroke="{DynamicResource Text}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 4,0 H 11 V 7 M 11,0 L 4.5,6.5 M 8,9 V 11 H 0 V 3 H 2" />
            </Button>
        </Grid>
    </Border>
</Window>
