<Window x:Class="StopWatch.ConfirmRemoveWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Remove issue row"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontSize="12">

    <StackPanel Margin="16" Width="280">
        <TextBlock x:Name="tbMessage" TextWrapping="Wrap" />

        <TextBlock x:Name="tbRunning"
                   Margin="0,6,0,0"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Text="The timer is still running."
                   IsVisible="False" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Remove" Click="btnRemove_Click" />
            <Button x:Name="btnCancel" Content="Cancel" IsDefault="True" IsCancel="True" Click="btnCancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
