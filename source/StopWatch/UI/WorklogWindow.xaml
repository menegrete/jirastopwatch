<Window x:Class="StopWatch.WorklogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Submit worklog"
        Background="{DynamicResource Background}"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="12">

    <StackPanel Margin="16">

        <TextBlock Text="Add a Comment to your work log (optional)" FontWeight="SemiBold" />

        <TextBox x:Name="tbComment"
                 Margin="0,6,0,0"
                 Height="90"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 KeyDown="tbComment_KeyDown" />

        <TextBlock Text="Press CTRL-Enter to submit"
                   Margin="0,4,0,0"
                   Style="{StaticResource MutedText}" />

        <!-- ==================== start time ==================== -->

        <TextBlock Text="Start Time" Style="{StaticResource SectionHeader}" />

        <!--
            Plain themed TextBoxes rather than a DatePicker: DatePicker's
            default template (the calendar-icon button, the popup calendar)
            is unstyled by anything in Styles.xaml, so it rendered with
            WPF's stock light theme - unreadable against the rest of this
            dialog, and its own internal layout kept it from lining up
            cleanly with the time field beside it. A typed date needs no
            template of its own to theme.
        -->
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="tbStartDate"
                     Width="100"
                     TextAlignment="Center"
                     ToolTip="Start date of the worklog" />
            <TextBox x:Name="tbStartTime"
                     Width="80"
                     Margin="8,0,0,0"
                     TextAlignment="Center"
                     ToolTip="Start time of the worklog, as HH:mm" />
        </StackPanel>

        <!-- ==================== remaining estimate ==================== -->

        <GroupBox Header="Remaining Estimate">
            <StackPanel>
                <RadioButton x:Name="rdEstimateAdjustAuto"
                             Content="Adjust _Automatically"
                             GroupName="estimate"
                             Checked="estimateUpdateMethod_Changed" />

                <RadioButton x:Name="rdEstimateAdjustLeave"
                             Content="_Leave Unchanged"
                             GroupName="estimate"
                             Checked="estimateUpdateMethod_Changed" />

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"
                                 x:Name="rdEstimateAdjustSetTo"
                                 Content="_Set To"
                                 GroupName="estimate"
                                 Checked="estimateUpdateMethod_Changed" />
                    <TextBox Grid.Column="1"
                             x:Name="tbSetTo"
                             IsEnabled="False"
                             LostFocus="EstimateValue_LostFocus"
                             TextChanged="EstimateValue_TextChanged"
                             KeyDown="EstimateValue_KeyDown" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"
                                 x:Name="rdEstimateAdjustManualDecrease"
                                 Content="_Reduce By"
                                 GroupName="estimate"
                                 Checked="estimateUpdateMethod_Changed" />
                    <TextBox Grid.Column="1"
                             x:Name="tbReduceBy"
                             IsEnabled="False"
                             LostFocus="EstimateValue_LostFocus"
                             TextChanged="EstimateValue_TextChanged"
                             KeyDown="EstimateValue_KeyDown" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ==================== the three ways out ==================== -->

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Su_bmit" IsDefault="True" Click="btnSubmit_Click" />
            <Button Content="Sa_ve for later" Margin="8,0,0,0" Click="btnSaveForLater_Click" />
            <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
